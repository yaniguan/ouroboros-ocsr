{
  "name": "ocsr-edge-v0",
  "note": "Gate limits (min_margin=0.05, max_disagreement=0.0) locked on PMC val (92.19% precision at 19.9% coverage across 963 images; benchmarks/selective-gate/). Student training has not been run yet.",
  "teacher": {
    "checkpoints": ["checkpoints/finetune-v2-A.pt", "checkpoints/finetune-v2-C.pt"],
    "beam": 5,
    "tta": ["pad"]
  },
  "pseudo_labels": {
    "shards": "real/unlabeled",
    "split": "train",
    "min_margin": 0.05,
    "max_disagreement": 0.0
  },
  "leakage_eval_sets": [
    "subset100=real/subset100:test",
    "frozen_v2=benchmarks/frozen-test-v2/manifest.csv"
  ],
  "student": {
    "arm": "A",
    "decoding": "greedy",
    "config": "configs/finetune-real-pmc.yaml",
    "init": "checkpoints/finetune-v2-A.pt",
    "synthetic_root": "data/synth-aug/shards",
    "real_roots": ["real/pmc"]
  },
  "selection": {
    "shards": "real/pmc",
    "split": "val"
  },
  "quantize": {
    "method": "int8-dynamic"
  },
  "target": {
    "device": "jetson-orin-nano-super",
    "fallback": "cpu"
  }
}
